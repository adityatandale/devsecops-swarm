# --- LLM (OpenAI-compatible endpoint) ---
# Ollama (default):  http://localhost:11434/v1   model e.g. deepseek-coder:6.7b  or  llama3:8b
# vLLM:              http://localhost:8000/v1    model e.g. deepseek-ai/deepseek-coder-6.7b-instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=deepseek-coder:6.7b
LLM_API_KEY=ollama

# --- Qdrant: leave empty to use embedded local storage (.qdrant/) ---
QDRANT_URL=

# --- Sandbox: docker | local (local = no isolation, only for quick dev) ---
SANDBOX_MODE=docker
SANDBOX_IMAGE=devsecops-sandbox:latest

# --- Pull request ---
DRY_RUN_PR=true
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
BASE_BRANCH=main
